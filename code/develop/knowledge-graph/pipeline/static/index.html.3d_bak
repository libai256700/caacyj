<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>云技 · 3D知识图谱</title>
<script src="three.min.js"></script>
<script src="3d-force-graph.min.js"></script>
<style>
:root{color-scheme:dark;--bg:#070b14;--panel:#0d1424d9;--panel2:#111b30e8;--line:#263652;--line2:#3b5d8f;--text:#eef6ff;--muted:#9fb0c5;--dim:#65758b;--primary:#42a5f5;--accent:#26c6da;--category:#ffa726;--danger:#ef5350;--ok:#66bb6a;--shadow:0 18px 50px rgba(0,0,0,.35);--radius:18px}
*{box-sizing:border-box;margin:0;padding:0}html,body{width:100%;height:100%;overflow:hidden}body{font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","PingFang SC","Microsoft YaHei",Arial,sans-serif;background:radial-gradient(circle at 20% 0%,rgba(66,165,245,.20),transparent 34%),radial-gradient(circle at 90% 12%,rgba(255,167,38,.16),transparent 30%),linear-gradient(135deg,#050812,#0a1020 56%,#05070d);color:var(--text)}button,input{font:inherit}button{cursor:pointer;border:0}a{color:#65c7ff;text-decoration:none}a:hover{text-decoration:underline}
.app{height:100%;display:grid;grid-template-columns:240px minmax(0,1fr) 330px;grid-template-rows:64px minmax(0,1fr)}
.topbar{grid-column:1/4;display:flex;align-items:center;gap:14px;padding:0 18px;border-bottom:1px solid rgba(100,140,190,.28);background:linear-gradient(180deg,rgba(16,28,49,.88),rgba(8,13,24,.72));backdrop-filter:blur(18px);box-shadow:0 12px 38px rgba(0,0,0,.25);z-index:20}.brand{font-weight:900;letter-spacing:.4px;white-space:nowrap}.brand span{color:var(--category)}.stats{margin-left:auto;color:var(--muted);font-size:12px;border:1px solid var(--line);border-radius:999px;padding:7px 12px;background:rgba(8,13,24,.72)}.stats b{color:var(--accent)}.top-btn{border:1px solid var(--line);border-radius:999px;padding:8px 12px;background:rgba(17,27,48,.76);color:var(--muted);font-size:12px;font-weight:800}.top-btn:hover{color:#fff;border-color:var(--line2);background:rgba(28,45,78,.9)}
.left{min-width:0;border-right:1px solid rgba(100,140,190,.25);background:linear-gradient(180deg,var(--panel2),var(--panel));display:flex;flex-direction:column;box-shadow:18px 0 44px rgba(0,0,0,.18);z-index:10;transition:width .22s ease,transform .22s ease}.left.collapsed{transform:translateX(-240px)}.left-head{height:54px;display:flex;align-items:center;justify-content:space-between;padding:0 14px;border-bottom:1px solid var(--line)}.panel-title{font-size:12px;font-weight:900;letter-spacing:1px;color:var(--category);text-transform:uppercase}.collapse-btn{position:absolute;left:250px;top:78px;z-index:18;width:34px;height:34px;border-radius:50%;border:1px solid var(--line);background:rgba(13,20,36,.88);color:#fff;box-shadow:var(--shadow)}.left.collapsed+.collapse-btn{left:10px}.filter-tools{padding:12px;border-bottom:1px solid var(--line);display:grid;gap:9px}.search{width:100%;border:1px solid var(--line);border-radius:12px;background:rgba(5,9,17,.72);color:var(--text);padding:10px 11px;outline:none}.search:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(66,165,245,.16)}.bulk{display:flex;gap:8px}.bulk button{flex:1;border:1px solid var(--line);border-radius:10px;background:rgba(20,31,53,.82);color:var(--muted);padding:8px 0;font-size:11px;font-weight:800}.bulk button:hover{color:#fff;border-color:var(--line2)}.cat-list{flex:1;overflow:auto;padding:10px}.cat-item{display:grid;grid-template-columns:auto 1fr auto;gap:9px;align-items:center;padding:10px 8px;border:1px solid transparent;border-radius:13px;margin-bottom:7px;background:rgba(10,16,29,.34);transition:.16s ease}.cat-item:hover{border-color:rgba(255,167,38,.34);background:rgba(30,24,14,.46)}.cat-dot{width:10px;height:10px;border-radius:50%;background:var(--category);box-shadow:0 0 16px rgba(255,167,38,.65)}.cat-name{min-width:0}.cat-label{font-size:12px;font-weight:850;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.cat-count{font-size:10px;color:var(--dim);margin-top:2px}.switch{width:42px;height:23px;border-radius:999px;background:#334155;position:relative;box-shadow:inset 0 0 0 1px rgba(255,255,255,.08)}.switch:before{content:"";position:absolute;width:17px;height:17px;border-radius:50%;left:3px;top:3px;background:#cbd5e1;transition:.18s ease}.switch.on{background:linear-gradient(135deg,var(--category),#ffd54f)}.switch.on:before{left:22px;background:#fff}.cat-item.off{opacity:.42}.cat-item.off .cat-dot{background:#718096;box-shadow:none}.left-foot{padding:12px;border-top:1px solid var(--line);color:var(--dim);font-size:11px;line-height:1.5}
.graph-wrap{position:relative;min-width:0;overflow:hidden;background:radial-gradient(circle at 50% 45%,rgba(33,72,118,.44),rgba(8,13,24,.92) 55%,#03060b)}.graph-wrap:before{content:"";position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.028) 1px,transparent 1px);background-size:42px 42px;mask-image:radial-gradient(circle at center,#000 0%,transparent 76%);z-index:1}#graph3d{position:absolute;inset:0;z-index:2}.hud{position:absolute;left:16px;top:16px;z-index:6;display:flex;gap:9px;align-items:center;flex-wrap:wrap;max-width:calc(100% - 32px);pointer-events:none}.hud-card{pointer-events:auto;border:1px solid rgba(90,130,180,.34);border-radius:999px;background:rgba(8,13,24,.68);backdrop-filter:blur(16px);box-shadow:var(--shadow);padding:8px 11px;color:var(--muted);font-size:12px}.hud-card b{color:#fff}.legend{position:absolute;left:50%;bottom:14px;transform:translateX(-50%);z-index:7;display:flex;gap:9px;flex-wrap:wrap;justify-content:center;max-width:94%;padding:9px 12px;border:1px solid var(--line);border-radius:18px;background:rgba(8,13,24,.72);backdrop-filter:blur(16px);box-shadow:var(--shadow)}.legend-item{display:flex;align-items:center;gap:5px;font-size:10px;color:var(--muted);font-weight:800;white-space:nowrap}.legend-dot{width:9px;height:9px;border-radius:50%;box-shadow:0 0 13px currentColor}.tip{position:fixed;display:none;z-index:50;max-width:310px;padding:12px;border:1px solid rgba(66,165,245,.65);border-radius:14px;background:rgba(9,15,27,.92);box-shadow:var(--shadow);backdrop-filter:blur(16px);pointer-events:none}.tip-title{font-weight:900;margin-bottom:5px}.tip-type{font-size:10px;color:var(--accent);font-weight:900;margin-bottom:6px}.tip-text{font-size:12px;line-height:1.5;color:var(--muted)}
.detail{border-left:1px solid rgba(100,140,190,.25);background:linear-gradient(180deg,var(--panel2),var(--panel));display:flex;flex-direction:column;box-shadow:-18px 0 44px rgba(0,0,0,.18);z-index:10}.detail-empty{margin:auto;text-align:center;color:var(--dim);font-size:13px;line-height:1.8;padding:24px}.detail-content{display:none;min-height:0;flex:1;overflow:auto}.detail.show .detail-empty{display:none}.detail.show .detail-content{display:block}.dp-head{padding:18px;border-bottom:1px solid var(--line);background:linear-gradient(180deg,rgba(38,198,218,.08),transparent)}.dp-title{font-size:19px;line-height:1.25;font-weight:950;word-break:break-word}.dp-type{display:inline-flex;margin-top:10px;padding:5px 9px;border-radius:999px;font-size:11px;font-weight:900;color:#fff}.dp-body{padding:16px}.section{margin-bottom:17px}.section-title{font-size:11px;text-transform:uppercase;letter-spacing:.8px;color:var(--primary);font-weight:950;margin-bottom:8px}.section-title.category{color:var(--category)}.section-title.doc{color:var(--accent)}.desc{font-size:13px;line-height:1.75;color:var(--muted);word-break:break-word}.rel-list{display:grid;gap:7px}.rel{border-left:3px solid var(--primary);border-radius:10px;background:rgba(5,9,17,.55);padding:8px 9px;font-size:12px;color:var(--muted);line-height:1.55}.rel strong{color:#fff;font-size:10px;margin-right:6px}.rel.category{border-left-color:var(--category)}.rel.doc{border-left-color:var(--accent)}.node-actions{display:flex;gap:8px;margin-top:13px}.node-actions button{flex:1;border:1px solid var(--line);border-radius:999px;background:rgba(20,31,53,.82);color:var(--muted);padding:8px;font-size:12px;font-weight:850}.node-actions button:hover{color:#fff;border-color:var(--line2)}.loading{position:fixed;inset:0;z-index:100;display:flex;align-items:center;justify-content:center;background:rgba(2,5,10,.48);backdrop-filter:blur(7px)}.loading.hide{display:none}.loader{display:flex;align-items:center;gap:11px;border:1px solid var(--line);border-radius:16px;background:rgba(13,20,36,.92);padding:16px 18px;box-shadow:var(--shadow);font-size:13px}.spin{width:22px;height:22px;border-radius:50%;border:3px solid rgba(255,255,255,.18);border-top-color:var(--primary);animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}.toast{position:fixed;right:18px;top:78px;z-index:120;display:none;max-width:380px;border:1px solid var(--line);border-radius:14px;background:rgba(13,20,36,.92);box-shadow:var(--shadow);padding:12px 14px;color:var(--text);font-size:12px}.toast.show{display:block}.toast.error{border-color:rgba(239,83,80,.72);color:#ffc4c2}.play-overlay{position:fixed;bottom:30px;left:50%;transform:translateX(-50%);z-index:200;display:none;padding:14px 28px;border-radius:999px;background:rgba(13,20,36,.94);border:1px solid var(--category);box-shadow:0 0 40px rgba(255,167,38,.3);color:#fff;font-size:15px;font-weight:950}.play-overlay.show{display:block}.play-overlay .play-label{color:var(--category)}
@media(max-width:980px){.app{grid-template-columns:240px minmax(0,1fr);grid-template-rows:64px minmax(0,1fr) 260px}.topbar{grid-column:1/3}.detail{grid-column:1/3;border-left:0;border-top:1px solid var(--line)}.stats{display:none}}@media(max-width:720px){.app{grid-template-columns:1fr}.topbar{grid-column:1}.left{position:absolute;left:0;top:64px;bottom:0;width:240px}.detail{display:none}.brand{font-size:14px}}
</style>
</head>
<body>
<div class="app">
  <div class="topbar">
    <div class="brand">⚡ 云技 <span>·</span> 3D知识图谱</div>
    <button class="top-btn" id="fitBtn">全景复位</button>
    <button class="top-btn" id="refreshBtn">刷新数据</button>
    <button class="top-btn" id="playBtn" style="background:linear-gradient(135deg,#ffa726,#ff7043);color:#fff;border-color:transparent">▶ 全屏播放</button>
    <div class="stats" id="statsBadge">加载中…</div>
  </div>
  <aside class="left" id="leftPanel">
    <div class="left-head"><div class="panel-title">Category Filters</div><div class="panel-title" id="catSummary">0/0</div></div>
    <div class="filter-tools">
      <input class="search" id="categorySearch" placeholder="搜索分类…">
      <div class="bulk"><button id="showAllBtn">全部开启</button><button id="hideAllBtn">全部关闭</button></div>
    </div>
    <div class="cat-list" id="categoryList"></div>
    <div class="left-foot">点击开关显示或隐藏该分类下所有节点、Category节点自身，以及相关连边。</div>
  </aside>
  <button class="collapse-btn" id="collapseBtn">‹</button>
  <main class="graph-wrap" id="graphWrap">
    <div id="graph3d"></div>
    <div class="hud"><div class="hud-card"><b id="visibleNodeCount">0</b> 节点</div><div class="hud-card"><b id="visibleEdgeCount">0</b> 关系</div><div class="hud-card">点击节点查看右侧详情</div></div>
    <div class="legend" id="legend"></div>
    <div class="tip" id="tooltip"></div>
  </main>
  <aside class="detail" id="detailPanel">
    <div class="detail-empty">选择一个节点<br>优先查看归属分类、来源文档与其他关系</div>
    <div class="detail-content">
      <div class="dp-head"><div class="dp-title" id="dpTitle">-</div><span class="dp-type" id="dpType">-</span><div class="node-actions"><button id="focusBtn">聚焦节点</button><button id="clearBtn">清除高亮</button></div></div>
      <div class="dp-body" id="dpBody"></div>
    </div>
  </aside>
</div>
<div class="loading" id="loading"><div class="loader"><div class="spin"></div><span id="loadingText">加载图谱数据…</span></div></div>
<div class="toast" id="toast"></div>
<div class="play-overlay" id="playOverlay"><span class="play-label" id="playLabel">播放中</span> — <span id="playNode"></span></div>
<script>
const TYPE_COLORS={'Category':'#ffa726','KnowledgePoint':'#42a5f5','Component':'#66bb6a','Skill':'#ab47bc','Regulation':'#ef5350','Certification':'#26c6da','Document':'#78909c','Position':'#ff7043','Company':'#29b6f6','Location':'#8d6e63','SalaryRange':'#9ccc65'};
const TYPE_ORDER=['Category','KnowledgePoint','Component','Skill','Regulation','Certification','Document','Position','Company','Location','SalaryRange'];
let Graph=null;
let allNodes=[];
let allEdges=[];
let nodeMap=new Map();
let categoryMap=new Map();
let categoryState=new Map();
let selectedNodeId=null;
let highlightIds=null;
let highlightEdgeIds=null;
function $(id){return document.getElementById(id)}
function escapeHtml(v){return String(v??'').replace(/[&<>'"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]})}
function toast(msg,type){const el=$('toast');el.textContent=msg;el.className='toast show '+(type||'');clearTimeout(el._t);el._t=setTimeout(function(){el.classList.remove('show')},3000)}
function setLoading(show,text){$('loadingText').textContent=text||'加载中…';$('loading').classList.toggle('hide',!show)}
function normNode(n){const id=String(n.id??n.identity??n.elementId??n.label??n.title??Math.random());const type=String(n.type??'KnowledgePoint');const label=String(n.label??n.title??n.name??id);return Object.assign({},n,{id:id,type:type,label:label,title:n.title??'',category:n.category??'',source_doc:n.source_doc??'',doc_url:n.doc_url??''})}
function normEdge(e,i){const from=String(e.from??e.source??e.from_id??'');const to=String(e.to??e.target??e.to_id??'');const label=String(e.label??e.type??'RELATED_TO');return Object.assign({},e,{id:String(e.id??from+'|'+to+'|'+label+'|'+i),from:from,to:to,source:from,target:to,label:label,title:e.title??e.description??''})}
async function fetchJson(url){const res=await fetch(url);if(!res.ok)throw new Error('HTTP '+res.status);return await res.json()}
async function loadData(){setLoading(true,'加载图谱数据…');try{const data=await fetchJson('/api/graph');allNodes=(data.nodes||[]).map(normNode);allEdges=(data.edges||[]).map(normEdge).filter(function(e){return e.from&&e.to});nodeMap=new Map(allNodes.map(function(n){return [n.id,n]}));buildCategories();buildCategoryPanel();buildLegend();updateGraph();loadStats();setTimeout(function(){var cn=allNodes.find(function(n){return n.type==='Category'});if(cn){focusNode(cn.id,true);setAllCategories(true)}else if(Graph)Graph.zoomToFit(700,70)},1800);toast('图谱加载完成','')}catch(e){toast('加载失败：'+e.message,'error')}finally{setLoading(false)}}
async function loadStats(){try{const st=await fetchJson('/api/stats');$('statsBadge').innerHTML='<b>'+escapeHtml(st.nodes??st.entities??allNodes.length)+'</b> 节点 · <b>'+escapeHtml(st.edges??st.relations??allEdges.length)+'</b> 关系'}catch(e){$('statsBadge').innerHTML='<b>'+allNodes.length+'</b> 节点 · <b>'+allEdges.length+'</b> 关系'}}
function buildCategories(){categoryMap=new Map();allNodes.filter(function(n){return n.type==='Category'}).forEach(function(n){categoryMap.set(n.label,{id:n.id,label:n.label,nodeIds:new Set([n.id])})});allNodes.forEach(function(n){if(n.category){if(!categoryMap.has(n.category))categoryMap.set(n.category,{id:null,label:n.category,nodeIds:new Set()});categoryMap.get(n.category).nodeIds.add(n.id)}});allEdges.forEach(function(e){const a=nodeMap.get(e.from);const b=nodeMap.get(e.to);if(e.label==='BELONGS_TO'&&b&&b.type==='Category'){if(!categoryMap.has(b.label))categoryMap.set(b.label,{id:b.id,label:b.label,nodeIds:new Set([b.id])});categoryMap.get(b.label).nodeIds.add(e.from);categoryMap.get(b.label).nodeIds.add(b.id)}if(e.label==='BELONGS_TO'&&a&&a.type==='Category'){if(!categoryMap.has(a.label))categoryMap.set(a.label,{id:a.id,label:a.label,nodeIds:new Set([a.id])});categoryMap.get(a.label).nodeIds.add(e.to);categoryMap.get(a.label).nodeIds.add(a.id)}});allNodes.filter(function(n){return n.type==='Category'&&!categoryMap.has(n.label)}).forEach(function(n){categoryMap.set(n.label,{id:n.id,label:n.label,nodeIds:new Set([n.id])})});categoryMap.forEach(function(cat,label){if(!categoryState.has(label))categoryState.set(label,true)})}
function sortedCategories(){return Array.from(categoryMap.values()).sort(function(a,b){return a.label.localeCompare(b.label,'zh-CN')})}
function buildCategoryPanel(){const q=($('categorySearch').value||'').trim().toLowerCase();const cats=sortedCategories().filter(function(c){return !q||c.label.toLowerCase().includes(q)});const list=$('categoryList');list.innerHTML=cats.map(function(c){const on=categoryState.get(c.label)!==false;return '<div class="cat-item '+(on?'':'off')+'" data-cat="'+escapeHtml(c.label)+'"><span class="cat-dot"></span><div class="cat-name"><div class="cat-label" title="'+escapeHtml(c.label)+'">'+escapeHtml(c.label)+'</div><div class="cat-count">'+c.nodeIds.size+' 个节点</div></div><button class="switch '+(on?'on':'')+'" aria-label="toggle '+escapeHtml(c.label)+'"></button></div>'}).join('')||'<div class="detail-empty">暂无分类</div>';list.querySelectorAll('.cat-item').forEach(function(el){el.addEventListener('click',function(){toggleCategory(el.dataset.cat)})});updateCategorySummary()}
function updateCategorySummary(){const total=categoryMap.size;let on=0;categoryMap.forEach(function(v,k){if(categoryState.get(k)!==false)on++});$('catSummary').textContent=on+'/'+total}
function toggleCategory(label){categoryState.set(label,categoryState.get(label)===false);buildCategoryPanel();updateGraph()}
function setAllCategories(on){categoryMap.forEach(function(v,k){categoryState.set(k,on)});buildCategoryPanel();updateGraph()}
function activeNodeSet(){const visible=new Set();categoryMap.forEach(function(cat,label){if(categoryState.get(label)!==false)cat.nodeIds.forEach(function(id){visible.add(id)})});allNodes.forEach(function(n){if(!n.category&&n.type!=='Category'){const belongs=allEdges.some(function(e){return e.from===n.id&&e.label==='BELONGS_TO'&&nodeMap.get(e.to)&&nodeMap.get(e.to).type==='Category'});if(!belongs)visible.add(n.id)}});return visible}
function visibleGraphData(){const ids=activeNodeSet();let nodes=allNodes.filter(function(n){return ids.has(n.id)});let edges=allEdges.filter(function(e){return ids.has(e.from)&&ids.has(e.to)});if(highlightIds){nodes=nodes.map(function(n){return Object.assign({},n,{_dim:!highlightIds.has(n.id)})});edges=edges.map(function(e){return Object.assign({},e,{source:e.from,target:e.to,_dim:!highlightEdgeIds.has(e.id)})})}else{nodes=nodes.map(function(n){return Object.assign({},n)});edges=edges.map(function(e){return Object.assign({},e,{source:e.from,target:e.to})})}return {nodes:nodes,links:edges}}
function updateGraph(){if(!Graph)return;const data=visibleGraphData();Graph.graphData(data);$('visibleNodeCount').textContent=data.nodes.length;$('visibleEdgeCount').textContent=data.links.length;updateCategorySummary();setTimeout(function(){if(Graph)Graph.zoomToFit(700,70)},120)}
function initGraph(){if(typeof ForceGraph3D!=='function'){toast('3d-force-graph 未加载','error');return}Graph=ForceGraph3D()($('graph3d')).backgroundColor('rgba(0,0,0,0)').showNavInfo(false).nodeId('id').nodeVal(nodeSize).nodeColor(nodeColor).nodeOpacity(function(n){if(n.type==='Document')return .08;return n._dim?.16:.96}).nodeLabel(function(n){if(n.type==='Document')return'';return n.label+' / '+n.type}).nodeThreeObject(nodeObject).linkColor(function(l){if(l._dim)return'rgba(90,105,125,.08)';if(l.label==='BELONGS_TO'&&allNodes.find(function(n){return n.id===l.to&&n.type==='Category'}))return'rgba(255,167,38,.7)';return'rgba(120,160,210,.48)'}).linkOpacity(function(l){return l._dim?.06:.72}).linkWidth(function(l){return l._dim?.2:(highlightEdgeIds&&highlightEdgeIds.has(l.id)?2.8:1.2)}).linkDirectionalArrowLength(function(l){return l._dim?0:3.5}).linkDirectionalArrowRelPos(1).linkCurvature(.06).linkLabel(function(l){return l.label}).onNodeClick(function(n){selectNode(n.id);focusNode(n.id,true)}).onNodeHover(function(n){if(n)showTooltip(n);else hideTooltip()});Graph.d3Force('charge').strength(function(n){return n.type==='Category'?-1200:n.type==='Document'?-10:-100}).distanceMax(350);Graph.d3Force('link').distance(40).strength(.6);Graph.d3Force('center').strength(.35);Graph.warmupTicks(120);resizeGraph()}
function nodeSize(n){if(n.type==='Document')return 2;if(n.type==='Category')return 15;return {'KnowledgePoint':7,'Component':8,'Skill':8,'Regulation':8,'Certification':9,'Position':8,'Company':9,'Location':7,'SalaryRange':7}[n.type]||7}
function nodeColor(n){if(n.type==='Document')return'rgba(90,100,115,.15)';return TYPE_COLORS[n.type]||'#90a4ae'}
function nodeObject(node){const group=new THREE.Group();const size=nodeSize(node);const color=nodeColor(node);const geo=new THREE.SphereGeometry(size,node.type==='Category'?18:12,node.type==='Category'?18:12);const mat=new THREE.MeshLambertMaterial({color:color,transparent:true,opacity:node._dim?.22:.96});const sphere=new THREE.Mesh(geo,mat);group.add(sphere);if(node.type==='Category'){const ringGeo=new THREE.TorusGeometry(size+4,1.4,8,42);const ringMat=new THREE.MeshBasicMaterial({color:TYPE_COLORS.Category,transparent:true,opacity:node._dim?.20:.72});const ring=new THREE.Mesh(ringGeo,ringMat);ring.rotation.x=Math.PI/2;group.add(ring)}const label=node.label||node.id;const canvas=document.createElement('canvas');const ctx=canvas.getContext('2d');const fs=node.type==='Category'?30:24;ctx.font='800 '+fs+'px PingFang SC, Microsoft YaHei, Arial';const w=Math.min(520,Math.max(120,ctx.measureText(label).width+26));canvas.width=w;canvas.height=46;ctx.font='800 '+fs+'px PingFang SC, Microsoft YaHei, Arial';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillStyle=node.type==='Category'?'rgba(56,34,6,.72)':'rgba(5,10,18,.58)';roundRect(ctx,0,0,w,46,13);ctx.fill();ctx.strokeStyle=node.type==='Category'?'rgba(255,167,38,.72)':'rgba(120,170,230,.26)';ctx.stroke();ctx.fillStyle=node._dim?'rgba(200,210,220,.38)':'rgba(245,250,255,.94)';ctx.fillText(label,w/2,23);const texture=new THREE.CanvasTexture(canvas);const sprite=new THREE.Sprite(new THREE.SpriteMaterial({map:texture,transparent:true,opacity:node._dim?.35:.92,depthWrite:false}));sprite.scale.set(w/7.8,46/7.8,1);sprite.position.set(0,size+8,0);group.add(sprite);return group}
function roundRect(ctx,x,y,w,h,r){ctx.beginPath();ctx.moveTo(x+r,y);ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);ctx.closePath()}
function resizeGraph(){if(!Graph)return;const rect=$('graphWrap').getBoundingClientRect();Graph.width(rect.width).height(rect.height)}
function buildLegend(){const types=TYPE_ORDER.filter(function(t){return allNodes.some(function(n){return n.type===t})});$('legend').innerHTML=types.map(function(t){return '<span class="legend-item"><span class="legend-dot" style="background:'+TYPE_COLORS[t]+';color:'+TYPE_COLORS[t]+'"></span>'+escapeHtml(t)+'</span>'}).join('')}
function relationRows(nodeId){const cat=[],docs=[],others=[];allEdges.forEach(function(e){if(e.from!==nodeId&&e.to!==nodeId)return;const out=e.from===nodeId;const other=nodeMap.get(out?e.to:e.from);if(!other)return;const rel={edge:e,other:other,out:out};if(out&&e.label==='BELONGS_TO'&&other.type==='Category')cat.push(rel);else if((other.type==='Document')||e.label==='SOURCE_DOC'||e.label==='MENTIONS'||e.label==='EXTRACTED_FROM')docs.push(rel);else others.push(rel)});return {cat:cat,docs:docs,others:others}}
function selectNode(id){selectedNodeId=String(id);const n=nodeMap.get(selectedNodeId);if(!n)return;$('detailPanel').classList.add('show');$('dpTitle').textContent=n.label;$('dpType').textContent=n.type;$('dpType').style.background=nodeColor(n);const rels=relationRows(n.id);let html='';html+='<div class="section"><div class="section-title category">归属分类</div><div class="rel-list">';if(rels.cat.length){html+=rels.cat.map(function(r){return '<div class="rel category"><strong>BELONGS_TO</strong>'+escapeHtml(r.other.label)+'</div>'}).join('')}else if(n.category){html+='<div class="rel category"><strong>CATEGORY</strong>'+escapeHtml(n.category)+'</div>'}else{html+='<div class="rel category"><strong>未标注</strong>暂无归属分类</div>'}html+='</div></div>';html+='<div class="section"><div class="section-title doc">来源文档</div><div class="rel-list">';let docHtml='';if(n.source_doc||n.doc_url){docHtml+='<div class="rel doc"><strong>source_doc</strong>'+escapeHtml(n.source_doc||'查看原文')+(n.doc_url?' · <a target="_blank" href="'+escapeHtml(n.doc_url)+'">打开链接 ↗</a>':'')+'</div>'}rels.docs.forEach(function(r){docHtml+='<div class="rel doc"><strong>'+(r.out?'→ ':'← ')+escapeHtml(r.edge.label)+'</strong>'+escapeHtml(r.other.label)+'</div>'});html+=docHtml||'<div class="rel doc"><strong>暂无</strong>未找到来源文档</div>';html+='</div></div>';html+='<div class="section"><div class="section-title">节点说明</div><div class="desc">'+escapeHtml(n.title||n.description||'暂无说明')+'</div></div>';html+='<div class="section"><div class="section-title">其他关系</div><div class="rel-list">';html+=rels.others.length?rels.others.slice(0,80).map(function(r){return '<div class="rel"><strong>'+(r.out?'→ ':'← ')+escapeHtml(r.edge.label)+'</strong>'+escapeHtml(r.other.label)+(r.edge.title?' · '+escapeHtml(r.edge.title):'')+'</div>'}).join(''):'<div class="rel"><strong>暂无</strong>没有其他关系</div>';html+='</div></div>';$('dpBody').innerHTML=html}
function focusNode(id,moveCamera){const ids=new Set([String(id)]);const eids=new Set();allEdges.forEach(function(e){if(e.from===id||e.to===id){ids.add(e.from);ids.add(e.to);eids.add(e.id)}});highlightIds=ids;highlightEdgeIds=eids;updateGraph();if(moveCamera){setTimeout(function(){const n=Graph.graphData().nodes.find(function(x){return x.id===id});if(n&&n.x!==undefined){const dist=170;const r=1+dist/Math.max(1,Math.hypot(n.x,n.y,n.z));Graph.cameraPosition({x:n.x*r,y:n.y*r,z:n.z*r},n,900)}},80)}}
function clearHighlight(){highlightIds=null;highlightEdgeIds=null;updateGraph()}var playTimer=null;function togglePlay(){if(playTimer){stopPlay();return}playTimer=1;$('playBtn').textContent='⏸ 停止';$('playBtn').style.background='';$('playBtn').style.color='';$('playBtn').style.borderColor='';$('playOverlay').classList.add('show');setAllCategories(true);if(Graph)Graph.zoomToFit(500,50);var cats=sortedCategories();var idx=0,cnt=cats.length;if(!cnt){stopPlay();return}function step(){if(!playTimer)return;var c=cats[idx];$('playLabel').textContent=c.label;$('playNode').textContent=c.nodeIds.size+'个节点';var n=allNodes.find(function(x){return x.type==='Category'&&x.label===c.label});if(n){focusNode(n.id,true);Graph.cameraPosition({x:n.x*2.4,y:n.y*2.4,z:n.z*2.4},n,1800)}idx=(idx+1)%cnt;playTimer=setTimeout(step,4000)}setTimeout(step,600)}function stopPlay(){if(playTimer){clearTimeout(playTimer);playTimer=null}$('playBtn').textContent='▶ 全屏播放';$('playBtn').style.background='linear-gradient(135deg,#ffa726,#ff7043)';$('playBtn').style.color='#fff';$('playBtn').style.borderColor='transparent';$('playOverlay').classList.remove('show');clearHighlight();if(Graph)Graph.zoomToFit(700,70)}
function showTooltip(node){const tip=$('tooltip');tip.innerHTML='<div class="tip-title">'+escapeHtml(node.label)+'</div><div class="tip-type">'+escapeHtml(node.type)+'</div><div class="tip-text">'+escapeHtml(node.title||node.category||'点击查看详情')+'</div>';tip.style.display='block';document.onmousemove=function(e){tip.style.left=e.clientX+14+'px';tip.style.top=e.clientY+12+'px'}}
function hideTooltip(){$('tooltip').style.display='none';document.onmousemove=null}
function setup(){initGraph();$('categorySearch').addEventListener('input',buildCategoryPanel);$('showAllBtn').addEventListener('click',function(){setAllCategories(true)});$('hideAllBtn').addEventListener('click',function(){setAllCategories(false)});$('fitBtn').addEventListener('click',function(){if(Graph)Graph.zoomToFit(700,70)});$('refreshBtn').addEventListener('click',loadData);$('playBtn').addEventListener('click',togglePlay);$('focusBtn').addEventListener('click',function(){if(selectedNodeId)focusNode(selectedNodeId,true)});$('clearBtn').addEventListener('click',clearHighlight);$('collapseBtn').addEventListener('click',function(){const p=$('leftPanel');p.classList.toggle('collapsed');$('collapseBtn').textContent=p.classList.contains('collapsed')?'›':'‹';setTimeout(resizeGraph,240)});window.addEventListener('resize',resizeGraph);loadData()}
document.addEventListener('DOMContentLoaded',setup);
</script>
</body>
</html>
