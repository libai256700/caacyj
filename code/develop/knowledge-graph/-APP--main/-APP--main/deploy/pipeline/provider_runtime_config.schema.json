{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowledge-qa:kg-provider-runtime-config-v1",
  "title": "Provider-neutral production runtime configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "network_mode",
    "approval_binding",
    "server_answer",
    "embedding"
  ],
  "properties": {
    "schema_version": {"const": "kg-provider-runtime-config-v1"},
    "network_mode": {"enum": ["disabled", "https"]},
    "approval_binding": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/approvalBinding"}
      ]
    },
    "server_answer": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/serverAnswer"}
      ]
    },
    "embedding": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/embedding"}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"network_mode": {"const": "disabled"}}},
      "then": {
        "properties": {
          "approval_binding": {"type": "null"},
          "server_answer": {"type": "null"},
          "embedding": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"network_mode": {"const": "https"}}},
      "then": {
        "properties": {
          "approval_binding": {"$ref": "#/$defs/approvalBinding"},
          "server_answer": {"$ref": "#/$defs/serverAnswer"},
          "embedding": {"$ref": "#/$defs/embedding"}
        }
      }
    }
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 512},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "absolutePath": {"type": "string", "pattern": "^/"},
    "secretRef": {
      "type": "string",
      "pattern": "^secretref:KG_[A-Z0-9_]{1,96}$"
    },
    "positiveInteger": {"type": "integer", "minimum": 1},
    "nonNegativeInteger": {"type": "integer", "minimum": 0},
    "positiveNumber": {"type": "number", "exclusiveMinimum": 0},
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["header_name", "prefix"],
      "properties": {
        "header_name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$"
        },
        "prefix": {"type": "string", "maxLength": 128}
      }
    },
    "meters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_meter_id", "output_meter_id", "cost_meter_id"],
      "properties": {
        "input_meter_id": {
          "enum": ["utf8_bytes-v1", "unicode_codepoints-v1"]
        },
        "output_meter_id": {
          "enum": ["utf8_bytes-v1", "unicode_codepoints-v1"]
        },
        "cost_meter_id": {"const": "maximum_request_exposure-v1"}
      }
    },
    "approvalBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_path",
        "receipt_sha256",
        "stop_b_request_path",
        "stop_b_request_sha256",
        "contract_materials_path",
        "contract_materials_sha256",
        "egress_policy_path",
        "egress_policy_sha256"
      ],
      "properties": {
        "receipt_path": {"$ref": "#/$defs/absolutePath"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "stop_b_request_path": {"$ref": "#/$defs/absolutePath"},
        "stop_b_request_sha256": {"$ref": "#/$defs/sha256"},
        "contract_materials_path": {"$ref": "#/$defs/absolutePath"},
        "contract_materials_sha256": {"$ref": "#/$defs/sha256"},
        "egress_policy_path": {"$ref": "#/$defs/absolutePath"},
        "egress_policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "answerLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds",
        "max_input_units",
        "max_output_units",
        "max_cost_microunits",
        "max_request_bytes",
        "max_response_bytes"
      ],
      "properties": {
        "timeout_seconds": {"$ref": "#/$defs/positiveNumber"},
        "max_input_units": {"$ref": "#/$defs/positiveInteger"},
        "max_output_units": {"$ref": "#/$defs/positiveInteger"},
        "max_cost_microunits": {"$ref": "#/$defs/nonNegativeInteger"},
        "max_request_bytes": {"$ref": "#/$defs/positiveInteger"},
        "max_response_bytes": {"$ref": "#/$defs/positiveInteger"}
      }
    },
    "answerWire": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_schema_sha256",
        "response_schema_sha256",
        "body_template",
        "answer_pointer",
        "wire_contract_sha256"
      ],
      "properties": {
        "schema_version": {"const": "kg-provider-answer-wire-v1"},
        "request_schema_sha256": {"$ref": "#/$defs/sha256"},
        "response_schema_sha256": {"$ref": "#/$defs/sha256"},
        "body_template": {},
        "answer_pointer": {"type": "string", "pattern": "^/"},
        "wire_contract_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "answerChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "approval_role_id",
        "provider",
        "endpoint",
        "region",
        "model",
        "model_version",
        "api_version",
        "identity_sha256",
        "secret_ref",
        "auth",
        "limits",
        "meters",
        "wire"
      ],
      "properties": {
        "channel_id": {"$ref": "#/$defs/text"},
        "approval_role_id": {"$ref": "#/$defs/text"},
        "provider": {"$ref": "#/$defs/text"},
        "endpoint": {"type": "string", "pattern": "^https://"},
        "region": {"$ref": "#/$defs/text"},
        "model": {"$ref": "#/$defs/text"},
        "model_version": {"$ref": "#/$defs/text"},
        "api_version": {"$ref": "#/$defs/text"},
        "identity_sha256": {"$ref": "#/$defs/sha256"},
        "secret_ref": {"$ref": "#/$defs/secretRef"},
        "auth": {"$ref": "#/$defs/auth"},
        "limits": {"$ref": "#/$defs/answerLimits"},
        "meters": {"$ref": "#/$defs/meters"},
        "wire": {"$ref": "#/$defs/answerWire"}
      }
    },
    "serverAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "winner_policy",
        "total_budget_seconds",
        "total_cost_budget_microunits",
        "circuit_breaker_failure_threshold",
        "circuit_breaker_cooldown_seconds",
        "channels"
      ],
      "properties": {
        "strategy": {
          "enum": ["single", "sequential_fallback", "parallel_hedge"]
        },
        "winner_policy": {"enum": ["first_success", "ordered_success"]},
        "total_budget_seconds": {"$ref": "#/$defs/positiveNumber"},
        "total_cost_budget_microunits": {
          "$ref": "#/$defs/positiveInteger"
        },
        "circuit_breaker_failure_threshold": {
          "$ref": "#/$defs/positiveInteger"
        },
        "circuit_breaker_cooldown_seconds": {
          "$ref": "#/$defs/positiveNumber"
        },
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/answerChannel"}
        }
      }
    },
    "embeddingIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "endpoint",
        "region",
        "model",
        "model_version",
        "api_version",
        "dimension",
        "normalization",
        "input_type"
      ],
      "properties": {
        "provider": {"$ref": "#/$defs/text"},
        "endpoint": {"type": "string", "pattern": "^https://"},
        "region": {"$ref": "#/$defs/text"},
        "model": {"$ref": "#/$defs/text"},
        "model_version": {"$ref": "#/$defs/text"},
        "api_version": {"$ref": "#/$defs/text"},
        "dimension": {"$ref": "#/$defs/positiveInteger"},
        "normalization": {"enum": ["l2", "none"]},
        "input_type": {"$ref": "#/$defs/text"}
      }
    },
    "embeddingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_size",
        "max_input_units",
        "timeout_seconds",
        "max_retries",
        "max_requests_per_operation",
        "max_cost_microunits_per_request",
        "total_cost_budget_microunits",
        "max_request_bytes",
        "max_response_bytes"
      ],
      "properties": {
        "batch_size": {"$ref": "#/$defs/positiveInteger"},
        "max_input_units": {"$ref": "#/$defs/positiveInteger"},
        "timeout_seconds": {"$ref": "#/$defs/positiveNumber"},
        "max_retries": {"$ref": "#/$defs/nonNegativeInteger"},
        "max_requests_per_operation": {"$ref": "#/$defs/positiveInteger"},
        "max_cost_microunits_per_request": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "total_cost_budget_microunits": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "max_request_bytes": {"$ref": "#/$defs/positiveInteger"},
        "max_response_bytes": {"$ref": "#/$defs/positiveInteger"}
      }
    },
    "embeddingWire": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_schema_sha256",
        "response_schema_sha256",
        "body_template",
        "vectors_pointer",
        "values_pointer",
        "match_by",
        "id_pointer",
        "wire_contract_sha256"
      ],
      "properties": {
        "schema_version": {"const": "kg-provider-embedding-wire-v1"},
        "request_schema_sha256": {"$ref": "#/$defs/sha256"},
        "response_schema_sha256": {"$ref": "#/$defs/sha256"},
        "body_template": {},
        "vectors_pointer": {"type": "string", "pattern": "^/"},
        "values_pointer": {"type": "string", "pattern": "^/"},
        "match_by": {"enum": ["input_order", "response_id"]},
        "id_pointer": {"type": ["string", "null"]},
        "wire_contract_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_role_id",
        "identity",
        "identity_sha256",
        "policy",
        "policy_sha256",
        "secret_ref",
        "auth",
        "meters",
        "wire"
      ],
      "properties": {
        "approval_role_id": {"$ref": "#/$defs/text"},
        "identity": {"$ref": "#/$defs/embeddingIdentity"},
        "identity_sha256": {"$ref": "#/$defs/sha256"},
        "policy": {"$ref": "#/$defs/embeddingPolicy"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "secret_ref": {"$ref": "#/$defs/secretRef"},
        "auth": {"$ref": "#/$defs/auth"},
        "meters": {"$ref": "#/$defs/meters"},
        "wire": {"$ref": "#/$defs/embeddingWire"}
      }
    }
  }
}
