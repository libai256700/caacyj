{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/kg-cloud-runtime-config-v1.json",
  "title": "Knowledge QA active cloud runtime configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_release_id",
    "active_root",
    "provider_runtime",
    "authority",
    "bm25",
    "graph",
    "regulation_governance",
    "embedding",
    "local_vector",
    "server_answer"
  ],
  "properties": {
    "schema_version": {
      "const": "kg-cloud-runtime-config-v1"
    },
    "runtime_release_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "active_root": {
      "type": "string",
      "pattern": "^/"
    },
    "provider_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config_sha256"],
      "properties": {
        "config_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "authority": {
      "$ref": "#/$defs/artifactBinding"
    },
    "bm25": {
      "$ref": "#/$defs/artifactBinding"
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_path",
        "manifest_sha256",
        "release_id",
        "driver",
        "driver_version",
        "uri_env",
        "username_env",
        "password_env",
        "database_env",
        "query_timeout_seconds",
        "max_records"
      ],
      "properties": {
        "manifest_path": {
          "$ref": "#/$defs/relativePath"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "release_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "driver": {
          "const": "neo4j"
        },
        "driver_version": {
          "const": "6.2.0"
        },
        "uri_env": {
          "$ref": "#/$defs/environmentName"
        },
        "username_env": {
          "$ref": "#/$defs/environmentName"
        },
        "password_env": {
          "$ref": "#/$defs/environmentName"
        },
        "database_env": {
          "$ref": "#/$defs/environmentName"
        },
        "query_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_records": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "regulation_governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeline_path",
        "timeline_sha256",
        "superseded_path",
        "superseded_sha256"
      ],
      "properties": {
        "timeline_path": {
          "$ref": "#/$defs/relativePath"
        },
        "timeline_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "superseded_path": {
          "$ref": "#/$defs/relativePath"
        },
        "superseded_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_sha256", "policy_sha256"],
      "properties": {
        "identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "policy_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "local_vector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_root",
        "data_release_id",
        "manifest_sha256",
        "authority_manifest_sha256",
        "chunking_identity_sha256",
        "embedding_identity_sha256",
        "dimension",
        "metric",
        "schema_version",
        "chunk_index_name",
        "entity_index_name",
        "top_k_max",
        "max_vectors_per_index",
        "metadata_allowlist",
        "engine",
        "engine_version"
      ],
      "properties": {
        "data_root": {
          "$ref": "#/$defs/relativePath"
        },
        "data_release_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "authority_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "chunking_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "embedding_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "dimension": {
          "type": "integer",
          "minimum": 1
        },
        "metric": {
          "enum": ["cosine", "dot", "euclidean"]
        },
        "schema_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "chunk_index_name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "entity_index_name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "top_k_max": {
          "type": "integer",
          "minimum": 1
        },
        "max_vectors_per_index": {
          "type": "integer",
          "minimum": 1
        },
        "metadata_allowlist": {
          "type": "object",
          "additionalProperties": false,
          "required": ["chunk", "entity"],
          "properties": {
            "chunk": {
              "$ref": "#/$defs/uniqueStrings"
            },
            "entity": {
              "$ref": "#/$defs/uniqueStrings"
            }
          }
        },
        "engine": {
          "const": "usearch"
        },
        "engine_version": {
          "const": "2.26.2"
        }
      }
    },
    "server_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "winner_policy",
        "ordered_channels",
        "total_budget_seconds",
        "total_cost_budget_microunits",
        "circuit_breaker_failure_threshold",
        "circuit_breaker_cooldown_seconds"
      ],
      "properties": {
        "strategy": {
          "enum": ["single", "sequential_fallback", "parallel_hedge"]
        },
        "winner_policy": {
          "enum": ["first_success", "ordered_success"]
        },
        "ordered_channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["channel_id", "identity_sha256"],
            "properties": {
              "channel_id": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "identity_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "total_budget_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "total_cost_budget_microunits": {
          "type": "integer",
          "minimum": 1
        },
        "circuit_breaker_failure_threshold": {
          "type": "integer",
          "minimum": 1
        },
        "circuit_breaker_cooldown_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environmentName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\*?\\[\\]{}]).+$"
    },
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_path",
        "manifest_sha256",
        "data_path",
        "data_sha256"
      ],
      "properties": {
        "manifest_path": {
          "$ref": "#/$defs/relativePath"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "data_path": {
          "$ref": "#/$defs/relativePath"
        },
        "data_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
