    "max_missing_salary_rate": 0.55,
    "max_missing_location_rate": 0.35,
    "max_missing_url_rate": 0.25,
    "max_invalid_location_rate": 0.0,
    "max_invalid_salary_rate": 0.0,
    "platforms": {
